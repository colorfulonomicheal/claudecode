{
  "projectName": "Colorful Coffee - プロジェクト初期設定テンプレート",
  "projectDescription": "Claude Code AIエージェント環境のテンプレートプロジェクト",
  "repository": {
    "url": "https://github.com/colorfulonomicheal/colorfu-Agent.git",
    "branch": "claude/init-project-setup-oTod0"
  },
  "agents": {
    "enabled": true,
    "autoDiscovery": true
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(git fetch)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "FileSearch"
    ],
    "deny": [
      "Bash(rm -rf)",
      "Bash(sudo)",
      "Bash(git push --force)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '✓ ファイルが変更されました'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚡ コマンド実行中...'"
          }
        ]
      }
    ]
  }
}
